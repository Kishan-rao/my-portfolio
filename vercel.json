{
  "version": 2,
  "builds": [
    { "src": "backend/api/index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/api/index.js" },
    { "src": "/assets/(.*)", "dest": "frontend/assets/$1" },
    { "src": "/(.*\\.(html|css|js|png|jpg|jpeg|gif|svg|ico|webp))", "dest": "frontend/$1" },
    { "src": "/", "dest": "frontend/index.html" },
    { "src": "/(.*)", "dest": "frontend/$1" }
  ]
}
